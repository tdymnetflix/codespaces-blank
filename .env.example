# Copy to .env before starting Docker Compose.
# Keep .env private; it may contain HERMES_WEBUI_PASSWORD.

# Host UID/GID for files written into bind-mounted directories.
UID=1000
GID=1000

# Hermes state and the workspace shown in the WebUI.
# HERMES_HOME=/home/your-user/.hermes
# HERMES_WORKSPACE=/home/your-user/project

# Keep localhost binding unless you have a secured reverse proxy.
# HERMES_WEBUI_BIND=127.0.0.1

# Required when HERMES_WEBUI_BIND is not 127.0.0.1.
HERMES_WEBUI_PASSWORD=replace-with-a-long-random-password